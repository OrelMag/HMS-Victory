{
  "name": "hms-victory",
  "version": "1.0.0",
  "description": "Interactive 3D model of HMS Victory (1805) built with Three.js",
  "main": "src/main.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/app.js --minify",
