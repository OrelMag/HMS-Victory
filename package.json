  "bugs": {
    "url": "https://github.com/OrelMag/HMS-Victory/issues"
  },
  "homepage": "https://github.com/OrelMag/HMS-Victory#readme",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "private": true
}
